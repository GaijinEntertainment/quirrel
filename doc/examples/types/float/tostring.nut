println("(3.0).tostring() =", (3.0).tostring())   // a whole float prints with no decimal point
println("(3.5).tostring() =", (3.5).tostring())
println("type((3.0).tostring()) =", type((3.0).tostring()))

// tostring formats through "%g" with 6 significant digits
println("(1.0 / 3.0).tostring() =", (1.0 / 3.0).tostring())
