// decimal and hex integers; '_' is an ignored digit separator
let magazineCapacity = 30
let ammoCrateId = 0xFF00_A1

// a char literal is just an integer: the byte value of one character
let ammoTypeCode = 'A'

// a float takes a fraction, an exponent, or both
let dropChance = 0.05
let starShellRange = 3.5e3

println("magazineCapacity =", magazineCapacity)
println("ammoCrateId =", ammoCrateId)
println("ammoTypeCode =", ammoTypeCode)
println("dropChance =", dropChance)
println("starShellRange =", starShellRange)
